{
  "manifest_version": 3,
  "name": "TubeMaster",
  "description": "A video companion Chrome extension.",
  "version": "0.1.0",
  "action": {
    "default_title": "TubeMaster",
    "default_popup": "index.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": ["storage"]
}
